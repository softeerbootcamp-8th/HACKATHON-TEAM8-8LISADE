# Leave blank for the local Vite /api proxy.
# Set this in Vercel to the HTTPS EC2 API endpoint after TLS is configured.
VITE_API_BASE_URL=https://ec2-3-34-148-229.ap-northeast-2.compute.amazonaws.com

# Kakao Maps JavaScript key — browser-visible by design; restrict allowed domains in Kakao Developers.
# Keep the real value only in .env.local (gitignored). Never put REST/Admin keys in VITE_* variables.
VITE_KAKAO_MAP_APP_KEY=

# Firebase Web push (FCM) — public client identifiers, safe as placeholders.
# Copy to .env.local (gitignored) and fill in from Firebase Console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
