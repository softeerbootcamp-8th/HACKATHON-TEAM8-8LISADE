*.swp

# ---- Backend (Gradle/Java) ----
backend/.gradle/
backend/build/
backend/out/
!backend/gradle/wrapper/gradle-wrapper.jar
*.class
*.log
backend/logs/
HELP.md

# ---- Frontend (Node/Vite) ----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Env ----
.env
.env.local
.env.*.local

# ---- Docker ----
docker-compose.override.yml

# ---- Firebase (FCM) secrets ----
backend/src/main/resources/firebase-service-account.json

# ---- Android signing keys ----
# keystore는 repository 밖(예: ~/.keystores/)에 두고 경로를 주입한다.
# 아래는 실수로 repo 안에 만들었을 때를 막는 안전장치다.
*.jks
*.keystore
*.p12
keystore.properties
frontend/android/app/google-services.json

# ---- Capacitor ----
frontend/.capacitor/
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/captures/
frontend/android/*.iml
frontend/android/app/*.iml
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/App/App/public/
frontend/ios/App/App/capacitor.config.json
frontend/ios/App/DerivedData/
frontend/ios/**/*.xcuserstate
frontend/ios/**/xcuserdata/

# ---- Vercel ----
.vercel/
.vercelignore
deploy.sh
